# Application Configuration
APP_NAME=Highway Accident Detection System
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/highway_accident_detection
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Security
SECRET_KEY=your-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true

# Notification System Configuration
AUTO_NOTIFICATION_ENABLED=false
NOTIFICATION_INTERVAL_SECONDS=60
MIN_NOTIFICATION_INTERVAL=30
MAX_NOTIFICATION_INTERVAL=300
MAX_NOTIFICATION_RETRIES=10

# Hospital Search Configuration
HOSPITAL_SEARCH_RADIUS_KM=50
MAX_HOSPITALS_TO_NOTIFY=5

# Incident Configuration
INCIDENT_AUTO_RESOLVE_HOURS=24
HIGH_SEVERITY_THRESHOLD=0.8
MEDIUM_SEVERITY_THRESHOLD=0.5

# Camera Configuration
CAMERA_HEALTH_CHECK_INTERVAL_SECONDS=300
CAMERA_TIMEOUT_SECONDS=30

# System Mode
MAINTENANCE_MODE=false
TEST_MODE=true

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# SMS/Notification Provider (Example - Configure based on actual provider)
SMS_PROVIDER=twilio
SMS_ACCOUNT_SID=your_account_sid
SMS_AUTH_TOKEN=your_auth_token
SMS_FROM_NUMBER=+1234567890

# Email Configuration (Optional)
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@highway-accident-detection.com

# Webhook Configuration
WEBHOOK_VERIFICATION_TOKEN=your-webhook-verification-token

# Admin Configuration
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=ChangeThisPassword123!

# File Upload
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=uploads

# WebSocket Configuration
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS=100

# Timezone
TIMEZONE=UTC

# Performance
WORKER_PROCESSES=4
KEEP_ALIVE_TIMEOUT=65
