# Application Settings
APP_NAME="Highway Accident Detection System"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True

# Server
HOST="0.0.0.0"
PORT=8000

# Database (PostgreSQL with PostGIS extension)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/highway_accident_detection"
DATABASE_ECHO=False

# Security
SECRET_KEY="development_secret_key_change_in_production_environment_32chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Settings
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Google Maps API Integration
# Place your Google Maps API Key below:
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_ENABLED=True

# Notification System
AUTO_NOTIFICATION_ENABLED=False
NOTIFICATION_INTERVAL_SECONDS=60
HOSPITAL_SEARCH_RADIUS_KM=50.0

# SMS Provider Configuration
SMS_PROVIDER="twilio"

# Email Provider Configuration
EMAIL_ENABLED=False
