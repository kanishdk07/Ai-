# Application Settings
APP_NAME="Highway Accident Detection System"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True

# Server
HOST="0.0.0.0"
PORT=8000

# Database (PostgreSQL with PostGIS extension)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/highway_accident_detection"
DATABASE_ECHO=False

# Security (Generate a secure random secret key for production)
SECRET_KEY="replace_with_a_secure_random_secret_key_at_least_32_characters_long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Settings
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Google Maps API Integration
# Set GOOGLE_MAPS_API_KEY to your valid Google Maps API Key
# Enable Geocoding API, Distance Matrix API, and Maps Embed API in Google Cloud Console
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE
GOOGLE_MAPS_ENABLED=True

# Notification System
AUTO_NOTIFICATION_ENABLED=False
NOTIFICATION_INTERVAL_SECONDS=60
HOSPITAL_SEARCH_RADIUS_KM=50.0

# SMS Provider Configuration
SMS_PROVIDER="twilio"
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM_NUMBER=

# Email Provider Configuration
EMAIL_ENABLED=False
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
